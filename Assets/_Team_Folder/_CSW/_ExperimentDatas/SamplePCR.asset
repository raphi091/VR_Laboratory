    Instruction: 
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uC824 \uC804\uAE30\uC601\uB3D9\uC5D0 \uD544\uC694\uD55C Agarose
      gel\uC744 \uB9CC\uB4E4\uC5B4\uC57C \uD569\uB2C8\uB2E4."
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uC6B0\uC120 \uD2C0\uBD80\uD130 \uB9CC\uB4E4\uC5B4\uBCFC\uAE4C\uC694?"
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uAC80\uC740\uC0C9 \uC0AC\uACA9\uD615 \uD2C0\uC774 \uBCF4\uC774\uC2DC\uB098\uC694?
      \uAE38\uCB49\uD55C \uC0AC\uB2E4\uB9AC \uBAA8\uC591 \uBD80\uD488\uC744 \uB4E4\uC5B4\uC11C
