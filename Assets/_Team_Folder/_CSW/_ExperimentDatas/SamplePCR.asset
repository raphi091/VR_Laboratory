    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uADF8 \uD6C4, \uD504\uB77C\uC774\uBA38 \uC6A9\uC561, dNTP \uD63C\uD569\uC561,
      DNA \uC911\uD569\uD6A8\uC18C, PCR \uC644\uCDA9\uC6A9\uC561, \uCD08\uC21C\uC218\uB97C
