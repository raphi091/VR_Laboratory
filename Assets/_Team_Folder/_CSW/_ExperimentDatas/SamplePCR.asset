      \uC704\uC5D0 \uAC00\uC838\uAC04 \uD6C4 \uD31D\uC5C5\uCC3D\uC758 Yes\uB97C \uB20C\uB7EC\uC8FC\uC138\uC694."
    CompletionKeywords: []
