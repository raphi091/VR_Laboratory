    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uD2C0\uC744 \uB208 \uC55E\uC758 \uAE30\uACC4\uC5D0 \uAC00\uC838\uB2E4
      \uB304 \uD6C4, \uD31D\uC5C5\uCC3D\uC758 Yes\uB97C \uB20C\uB7EC\uC8FC\uC138\uC694."
    CompletionKeywords: []
  - Type: 1
