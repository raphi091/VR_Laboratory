    Instruction: 
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uB178\uB780\uC0C9 \uB69C\uAED1 \uD29C\uBE0C\uC5D0 \uB2F4\uC544
      \uC788\uB294 DNA\uC0D8\uD50C \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD574,
      \uD30C\uC774\uD3AB\uC73C\uB85C \uCD94\uCD9C\uD55C \uB2E4\uC74C \uBE48 \uD29C\uBE0C\uD615
