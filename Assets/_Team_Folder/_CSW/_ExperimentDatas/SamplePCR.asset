    CompletionKeywords: []
  - Type: 2
    LocationID: 
    Instruction: 
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uD30C\uC774\uD3AB\uC744 \uB4E4\uC5B4\uC11C agarose, TBE buffer,
      SYBR safe \uC5FC\uC0C9\uC57D\uC744 \uC0BC\uAC01\uD615 \uD50C\uB77C\uC2A4\uD06C\uC5D0
      \uC8FC\uC785\uD574\uC8FC\uC138\uC694."
    CompletionKeywords: []
  - Type: 2
    LocationID: 
    Instruction: 
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uBAA8\uB450 \uC8FC\uC785\uD558\uC168\uB2E4\uBA74, \uD50C\uB77C\uC2A4\uD06C\uC758
