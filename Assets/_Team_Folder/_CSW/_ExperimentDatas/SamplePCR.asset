  - Type: 1
    LocationID: 
    Instruction: "\uC624\uB978\uCABD \uC190\uC73C\uB85C \uD30C\uC774\uD3AB\uC744
      \uC9D1\uC5B4\uC8FC\uC138\uC694. \uC644\uB8CC\uD558\uC168\uB2E4\uBA74 \uC67C\uC190\uC73C\uB85C
