    CompletionKeywords: []
  - Type: 2
    LocationID: 
    Instruction: 
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uB9C8\uC9C0\uB9C9\uC73C\uB860 \uAE30\uACC4\uB97C \uC870\uC791\uD558\uB294
      \uBC95\uC744 \uBC30\uC6CC\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uD50C\uB77C\uC2A4\uD06C\uB97C \uB208 \uC55E\uC758 \uAE30\uACC4\uC5D0
      \uB123\uC5B4\uC8FC\uC138\uC694. \uD31D\uC5C5\uCC3D\uC774 \uB728\uBA74 \uBE48
      \uC190\uC73C\uB85C Yes\uB97C \uB20C\uB7EC\uC8FC\uC138\uC694."
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uD50C\uB77C\uC2A4\uD06C\uAC00 \uAE30\uACC4 \uC548\uC5D0 \uB4E4\uC5B4\uAC00\uC11C
