  - Type: 1
    LocationID: 
    Instruction: "\uC800\uB294 \uC5EC\uB7EC\uBD84\uC758 \uC2E4\uD5D8\uC744 \uB3C4\uC640\uC904
      AI\uC870\uC218 '\uB178\uC544'\uB77C\uACE0 \uD569\uB2C8\uB2E4."
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uC6B0\uC120, \uC778\uC0AC\uBD80\uD130 \uD574 \uBCFC\uAE4C\uC694?
      '\uC548\uB155' \uC774\uB77C\uACE0 \uB9D0\uD574 \uC8FC\uC138\uC694!"
    CompletionKeywords: []
  - Type: 3
    LocationID: 
    Instruction: 
    CompletionKeywords:
    - "\uC548\uB155"
  - Type: 1
    LocationID: 
    Instruction: "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4! \uC55E\uC73C\uB85C \uC800\uD55C\uD14C
      \uC774\uC57C\uAE30\uB97C \uD558\uACE0 \uC2F6\uC73C\uC2DC\uBA74, \uC67C\uCABD
      \uCEE8\uD2B8\uB864\uB7EC\uC758 X\uD0A4\uB97C \uB204\uB978 \uC0C1\uD0DC\uB85C
      \uB9D0\uC744 \uD558\uC2E0 \uD6C4, X\uD0A4\uB97C \uB5BC \uC8FC\uC138\uC694!"
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uB2E4\uC74C\uC740 \uB3C4\uAD6C \uC0AC\uC6A9\uBC95\uC744 \uC54C\uC544\uBCFC
      \uC2DC\uAC04\uC785\uB2C8\uB2E4. \uC800\uB97C \uB530\uB77C\uC640\uC8FC\uC138\uC694!"
    CompletionKeywords: []
  - Type: 0
    LocationID: 001
    Instruction: 
    CompletionKeywords: []
  - Type: 2
    LocationID: 
    Instruction: 
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uCC45\uC0C1 \uC704\uC758 \uD53C\uD3AB\uACFC \uD50C\uB77C\uC2A4\uD06C\uB97C
      \uC368\uBCF4\uC138\uC694!"
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uD53C\uD3AB\uC744 \uCEE8\uD2B8\uB864\uB7EC\uB85C \uC7A1\uC544\uBCF4\uC138\uC694."
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uD50C\uB77C\uC2A4\uD06C \uC548 \uC6A9\uC561\uC5D0 \uBC14\uB298\uC744
      \uAF42\uC740 \uD6C4 \uC624\uB978\uCABD \uCEE8\uD2B8\uB864\uB7EC\uC758 A\uD0A4\uB97C
      \uB20C\uB7EC\uC11C \uCD94\uCD9C\uD569\uB2C8\uB2E4."
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uB2E4\uB978 \uD50C\uB77C\uC2A4\uD06C\uC5D0 \uC8FC\uC785\uD558\uACE0
      \uC2F6\uC73C\uBA74 \uB9C8\uCC2C\uAC00\uC9C0\uB85C \uBC14\uB298\uC744 \uAF42\uC740
      \uD6C4 \uC624\uB978\uCABD \uCEE8\uD2B8\uB864\uB7EC\uC758 B\uD0A4\uB97C \uB204\uB985\uB2C8\uB2E4."
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uD50C\uB77C\uC2A4\uD06C\uB294 \uCEE8\uD2B8\uB864\uB7EC\uB85C \uC7A1\uACE0
      \uAE30\uC6B8\uC774\uBA74 \uC6A9\uC561\uC774 \uD758\uB7EC\uB098\uC635\uB2C8\uB2E4"
    CompletionKeywords: []
  - Type: 1
    LocationID: 
    Instruction: "\uB2E4\uC74C \uC7A5\uC18C\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.
      \uCDA9\uBD84\uD788 \uC870\uC791\uBC95\uC744 \uC775\uD788\uC168\uB2E4\uBA74
      \uC800\uB97C \uB530\uB77C\uC640\uC8FC\uC138\uC694!"
    CompletionKeywords: []
